# Copy to .env; keep your key only in the ignored .env file.
OPENAI_API_KEY=
# Explicit API model; can be changed after access/quality evaluation.
HOGLINE_VISION_MODEL=gpt-6.1-terra
# Maximum reserved spend for this local vision pilot, in USD.
HOGLINE_VISION_BUDGET_USD=5.00
# Remote processing stays off until you enable it.
HOGLINE_VISION_ENABLED=false

# Recording follow-up is enabled by default and shares the budget above.
# To stop new automatic skill clips, set HOGLINE_AUTO_SKILLS=0 in the server environment.
